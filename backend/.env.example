# Copy this file to backend/.env and replace the placeholders.
# NEVER commit backend/.env. It is ignored by .gitignore.

APP_NAME=EcoHealth API
# One of: development, test, production
APP_ENV=development
DEBUG=false

# Supabase -> Connect -> Session pooler (port 5432).
# Must start with postgresql+psycopg:// (SQLAlchemy + Psycopg 3 driver).
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# ---- Environmental data ----
# OpenAQ v3 API key (optional; free at https://explore.openaq.org/register).
# Without it, ground-station data is skipped and everything else still works.
OPENAQ_API_KEY=your-openaq-api-key
# Station readings older than this many hours are ignored / marked stale.
OPENAQ_MAX_AGE_HOURS=3

# ---- Environmental data cache (see docs/caching.md) ----
# Grid size in degrees (0.05 ~ 5 km); users in the same cell share cached data.
ENV_CACHE_GRID_DEGREES=0.05
# Elevation uses its own finer grid (0.01 ~ 1 km) because it changes fast in mountains.
ENV_CACHE_ELEVATION_GRID_DEGREES=0.01
ENV_CACHE_TTL_WEATHER_MINUTES=30
ENV_CACHE_TTL_AIR_QUALITY_MINUTES=30
ENV_CACHE_TTL_OPENAQ_MINUTES=30
ENV_CACHE_TTL_ELEVATION_DAYS=30
# Expired data is served (marked "stale") only if a live fetch fails and the data is younger than this.
ENV_CACHE_MAX_STALE_HOURS=6

# ---- Authentication (see docs/auth.md) ----
# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# true in production (HTTPS); false only for local http development
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# Cookie path as the BROWSER sees the auth endpoints. The frontend calls /api/auth/... through
# its same-origin proxy (Vite in dev, Vercel in production). Use /auth only for direct backend calls.
REFRESH_COOKIE_PATH=/api/auth
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Proxies whose X-Forwarded-For header is believed for the per-IP login limit.
# Comma-separated IPs / CIDR ranges; "localhost" = 127.0.0.1 and ::1 (the Vite dev proxy).
TRUSTED_PROXIES=localhost
