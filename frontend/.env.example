# Copy to frontend/.env.local (ignored by git) only if you need to change a default.
# Nothing here is a secret. Never put tokens, keys or passwords in frontend env files:
# every VITE_* variable is bundled into public browser code.

# Development only: where Vite's /api proxy forwards requests (read by vite.config.js in Node,
# never sent to the browser). Default: http://localhost:8000
DEV_API_TARGET=http://localhost:8000
