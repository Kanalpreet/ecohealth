# Frontend environment (EcoHealth). Copy to frontend/.env.local (ignored by git) only if you
# need to change a default; the app runs with no env file at all.
#
# Nothing here is a secret. Never put tokens, keys or passwords in frontend env files:
# every VITE_* variable is bundled into public browser code. This app currently reads NO
# VITE_* variables: the browser always calls same-origin /api/* (see docs/frontend.md §2).

# Development only: where Vite's /api proxy forwards requests (read by vite.config.js in Node,
# never sent to the browser). Default: http://localhost:8000
DEV_API_TARGET=http://localhost:8000

# Production (Vercel): no environment variables are needed. The backend address is set in
# vercel.json (replace the BACKEND_URL placeholder in the /api rewrite), because Vercel
# rewrites can't read environment variables. See "Deploying the frontend" in docs/frontend.md.

# End-to-end tests (npm run test:e2e) use http://localhost:5173 and expect the backend on
# http://localhost:8000. They need no variables.
